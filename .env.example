# yerel geliştirme içindir. gerçek anahtarları bu dosyaya değil, git-dışı .env dosyana koy.
APP_ENV=development
POSTGRES_DB=scanner
POSTGRES_USER=scanner
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://scanner:local-development-only@localhost:5432/scanner
REDIS_URL=redis://localhost:6379/0
SCAN_RATE_LIMIT_PER_MINUTE=5
SCAN_QUEUE_LIMIT=250
SCAN_JOB_TIMEOUT_SECONDS=90

# isteğe bağlı gerçek servis anahtarları; boş bırakılırsa o servis taramaya katılmaz.
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
